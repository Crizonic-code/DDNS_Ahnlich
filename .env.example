# DDNS_Ahnlich Environment Configuration
# Copy this to .env and update values

# PowerDNS API key (generate with: openssl rand -hex 32)
PDNS_API_KEY=your-pdns-api-key-here

# JWT secret for auth tokens (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Your DDNS domain (e.g., ddns.dasspec.com)
ZONE_NAME=ddns.dasspec.com
